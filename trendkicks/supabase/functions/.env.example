# Only server-side secrets. Never include these in Flutter build configuration.
XENDIT_SECRET_KEY=xnd_development_REPLACE_ME
XENDIT_WEBHOOK_TOKEN=REPLACE_WITH_DASHBOARD_VERIFICATION_TOKEN
# Optional: comma-separated enabled channel codes for your merchant account.
# Leave empty to use enabled Philippine Peso (PHP) invoice channels.
XENDIT_PAYMENT_METHODS=
# Random private secret for the optional cloud cleanup/push job; never put in Flutter.
STORE_JOB_SECRET=REPLACE_WITH_A_RANDOM_PRIVATE_SECRET
# Optional: Firebase service-account JSON on one line, server-side only.
# Leave unset for the fully functional in-app notification fallback.
# FCM_SERVICE_ACCOUNT_JSON={...}
